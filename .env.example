# Create a key at https://console.typesafe.ai/keys
# Leave empty to run in mock mode (fake answers, no API calls).
# Production uses a Pages secret instead: `wrangler pages secret put TYPESAFE_API_KEY`
TYPESAFE_API_KEY=

# Public Turnstile sitekey that scripts/deploy.sh bakes into the production build (see docs/deploy.md).
# Local dev leaves the human check off; scripts/dev-challenge.sh turns it on with Cloudflare's test keys.
VITE_TURNSTILE_SITE_KEY=
