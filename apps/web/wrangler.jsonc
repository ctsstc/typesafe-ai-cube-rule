{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cube-rule-oracle",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-22",
  // Placeholder ids. Local dev and tests use local stand-ins; scripts/cloudflare-config.mjs writes the
  // real ids from the root .env into the gitignored wrangler.production.jsonc for remote commands.
  "kv_namespaces": [{ "binding": "CLASSIFICATIONS", "id": "00000000000000000000000000000000" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cube-rule-oracle",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Jev calls allowed per UTC day, about $0.0004 each. "0" stops every new ruling. Keep it at or
    // under the Free plan's 1,000 KV writes a day, or later rulings go unstored and get billed again.
    "DAILY_CALL_LIMIT": "1000",
    // "off" empties /api/lists on the next deploy. Any value but "on" counts as off.
    // pnpm recent --lists off does the same without a deploy.
    "PUBLIC_LISTS": "on",
    // Listable rulings first seen in the last hour before the lists show an activity line. The
    // count stops at 50, so a higher value is read as 50.
    "ACTIVITY_THRESHOLD": "5"
  },
  "dev": { "port": 8788 }
}
